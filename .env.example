# Copy this file locally if needed. Never commit real secrets.

# Production currently runs as a public two-person app without Cloudflare Access.
ALLOW_PUBLIC_APP=true

DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-flash
AUTO_REFRESH_SECRET=replace-with-a-long-random-secret
# Scoped to Codex draft/image submission. It cannot publish drafts or call legacy write APIs.
CODEX_AUTOMATION_SECRET=replace-with-a-different-long-random-secret
CODEX_SITE_URL=https://bijinihaitan.cn
ADMIN_API_TOKEN=replace-with-a-separate-long-random-admin-token
# Optional HTTPS endpoint that accepts a JSON POST for daily-content failure/recovery alerts.
OPS_ALERT_WEBHOOK_URL=
TEAM_ACCESS_EMAILS=editor@example.com
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-your-access-application-aud
ALLOWED_ORIGINS=https://bijinihaitan.cn,https://www.bijinihaitan.cn
SITE_URL=https://bijinihaitan.cn

# Cloudflare rollback Worker HTTP API stays disabled by default.
# Production scheduling runs inside the Tencent runtime.
ENABLE_LEGACY_WORKER_API=false
ALLOW_INSECURE_LOCAL_DEV=false
