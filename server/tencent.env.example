# Install as /etc/japanese-words.env with mode 0600. Never commit real values.
ALLOW_PUBLIC_APP=true
SITE_URL=https://bijinihaitan.cn
ALLOWED_ORIGINS=https://bijinihaitan.cn,https://www.bijinihaitan.cn
JAPANESE_WORDS_DATA_DIR=/var/lib/japanese-words
JAPANESE_WORDS_BACKUP_DIR=/var/backups/japanese-words
PORT=8788
HOST=127.0.0.1
# Set true only while validating a pre-cutover staging copy.
DISABLE_SCHEDULER=false

DEEPSEEK_API_KEY=replace-on-server
DEEPSEEK_MODEL=deepseek-v4-flash
AUTO_REFRESH_SECRET=replace-on-server
CODEX_AUTOMATION_SECRET=replace-on-server
ADMIN_API_TOKEN=replace-on-server
# Optional HTTPS endpoint that accepts a JSON POST for daily-content failure/recovery alerts.
OPS_ALERT_WEBHOOK_URL=
